DATABASE_URL=postgres://gifserver:gifserver@localhost:5432/gifserver
STORAGE_PATH=storage
HOST=0.0.0.0
PORT=8847
BASE_URL=http://localhost:8847

# Matrix homeserver this server trusts. Only OpenID tokens from this server,
# and only users whose mxid lives here, can authenticate.
MATRIX_SERVER_NAME=example.com
# Where the homeserver's federation API is reachable for OpenID verification.
MATRIX_FEDERATION_URL=https://example.com:8448
# Comma-separated admin Matrix IDs (may delete/edit any shared GIF).
MATRIX_ADMIN_MXIDS=@you:example.com
# HMAC secret for signing session tokens. Use a long random value.
SESSION_SECRET=change-me-to-a-long-random-string
# Max total bytes of stored renditions. Suffix KB/MB/GB/TB; 0 disables.
STORAGE_MAX_BYTES=10GB
# Comma-separated browser origins allowed via CORS. Empty = any origin
# (with a startup warning). Set to your frontend origin in production.
CORS_ALLOWED_ORIGINS=
